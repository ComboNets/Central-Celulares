# Copy this file to .env and fill in values.
#
# IMPORTANT: never commit your real .env.

# WhatsApp contact number shown/used by the site (digits recommended).
# Example: VITE_WHATSAPP_NUMBER=595981234567
VITE_WHATSAPP_NUMBER=

# Live products API used by the public showcase site.
VITE_PRODUCTS_API_URL=https://admin.centralcelulares.com.py/api/products

# Live product image host. Product paths like /images/fotos/p-1.jpg are loaded from here.
VITE_PRODUCT_ASSET_BASE_URL=https://admin.centralcelulares.com.py

# Worker secrets used by the admin login. Set these with `npx wrangler secret put ...`.
# ADMIN_PASSWORD is the simplest option. ADMIN_PASSWORD_HASH can be used instead as a SHA-256 hex hash.
# ADMIN_PASSWORD=
# ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_SECRET=
